# ==========================================
# LingXi Engine - release .gitignore
# ==========================================

# Secrets & instance-specific files (NEVER commit)
.env
.env.local
web/js/platform-config.js
src/web/js/platform-config.js

# Dependencies
node_modules/

# Build outputs
release/
release-v2/
mobile-dist/
dist/
build/

# Databases & runtime data
*.db
*.db-journal
*.sqlite*
data/
storage/
uploads/
usage.json
*.pid
platform-server.log

# Backups & archives
*.bak
*.bak-*
*.func
*.old
*.zip
*.tar.gz
*.7z
_archive/
web_backup_*/
*backup*/

# Media & large binaries
*.mp3
*.mp4
*.wav
*.png
*.jpg
*.jpeg
*.gif
*.webp
frames/

# OS junk
Thumbs.db
Desktop.ini
.DS_Store

# Logs & temp
*.log
*.tmp
tsc*.txt
*_result.txt
*.pid
tmp/
tmp-verify*/