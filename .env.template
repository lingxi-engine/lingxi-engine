# ── 开发模式（公网部署务必设为 false）──
DEV_MODE=false
# DEV_MODE=false 时：
#   - requireAuth 真正强制 JWT 登录（不再免认证放行 admin）
#   - 生产环境必须确保 NODE_TLS_REJECT_UNAUTHORIZED 未设为 0
#   - 建议设置 NODE_EXTRA_CA_CERTS 指向自签名 CA（如有）

# ── 端口 ──
PORT=3456

# ── 默认模型 ──
DEFAULT_MODEL=deepseek-v4-flash
TOOL_MODEL=deepseek-v4-flash
REPLY_MODEL=deepseek-v4-pro

# ── 安全 ──
# JWT_SECRET=首次启动自动生成
# ADMIN_TOKEN=首次启动自动生成

# ── API Keys（按需配置）──
# DEEPSEEK_API_KEY=your-key
# NVIDIA_API_KEY=your-key
# OLLAMA_BASE_URL=http://localhost:11434

# LAN_SECRET: 局域网传输层 HMAC 签名密钥（首次启动自动生成写入 .env）
# 多机部署请手动设置为相同值；置空 LAN_SECRET= 可恢复仅协议头模式
LAN_SECRET=

# -- Hire market master switch (commercial marketplace is OFFLINE)
# When false (DEFAULT): /market.html, /market, /api/market/*, /api/mvp/*, /api/hire all return 404
# Set FEATURE_MARKET=true only when the marketplace is re-opened.
# Marketplace source code is retained in-repo for later revival; UI is hidden by default.
FEATURE_MARKET=false
