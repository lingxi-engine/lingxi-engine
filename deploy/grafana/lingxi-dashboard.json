{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "LingXi Engine",
  "uid": "lingxi-engine",
  "tags": ["lingxi", "ai", "engine"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Engine Up",
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [ { "expr": "lingxi_up", "refId": "A" } ],
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "1": { "text": "UP", "color": "green" }, "0": { "text": "DOWN", "color": "red" } } } ] }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Uptime",
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [ { "expr": "process_uptime_seconds", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP Request Rate by Status",
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "gridPos": { "h": 8, "w": 12, "x": 8, "y": 0 },
      "targets": [ { "expr": "sum by (status) (rate(lingxi_http_requests_total[5m]))", "legendFormat": "{{status}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Average HTTP Latency (ms)",
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [ { "expr": "rate(lingxi_http_request_duration_ms_sum[5m]) / rate(lingxi_http_request_duration_ms_count[5m])", "legendFormat": "avg ms", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "AI Calls per Minute by Model",
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [ { "expr": "sum by (model) (rate(lingxi_ai_calls_total[5m])) * 60", "legendFormat": "{{model}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "cpm" }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Token Throughput (prompt vs completion)",
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "sum(rate(lingxi_ai_prompt_tokens_total[5m])) * 60", "legendFormat": "prompt tok/min", "refId": "A" },
        { "expr": "sum(rate(lingxi_ai_completion_tokens_total[5m])) * 60", "legendFormat": "completion tok/min", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    }
  ]
}
