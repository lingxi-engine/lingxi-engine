# ============================================
# 灵犀引擎 环境变量示例
# 复制为 .env 后按需修改；带默认值的项可不填
# ============================================

# ── 开发模式（公网部署务必设为 false）──
DEV_MODE=false
USE_DOCKER_SANDBOX=false
CODE_EXEC_ALLOW_VM=1

# ── 端口 ──
PORT=3456

# ── 默认模型 ──
DEFAULT_MODEL=minimaxai/minimax-m3
TOOL_MODEL=minimaxai/minimax-m3
REPLY_MODEL=minimaxai/minimax-m3
ROUTE_ENABLED=true

# ── NVIDIA NIM（免费额度，可选）──
# 申请地址: https://build.nvidia.com
NVIDIA_API_KEY=

# ── 本地 Ollama（可选）──
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── 超时（秒）──
CHAT_TIMEOUT_SECONDS=300
TASK_TIMEOUT_SECONDS=1200
ORCHESTRATOR_TIMEOUT_SECONDS=600

# ── 审批策略 ──
# 置 1/true 自动通过所有审批（仅限本机开发）；留空则需人工审批
APPROVAL_AUTO_APPROVE=

# ── Mesh 多机互联 ──
# 平台地址（多机组网时填写，如 https://your-platform.example.com）；单机留空
MESH_PLATFORM_URL=
# 节点间通信令牌：务必改成强随机串（如 32 位以上）
MESH_TOKEN=change-me-to-a-strong-secret

# ── 平台绑定 ──
# 远程平台地址；留空 = 纯本地模式
# 示例: PLATFORM_URL=https://your-platform.example.com
PLATFORM_URL=