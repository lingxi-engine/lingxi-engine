# ────────────────────────────────────────
# 灵犀引擎 环境变量配置
# ────────────────────────────────────────
PORT=3456
DEFAULT_MODEL=minimaxai/minimax-m3

# ── NVIDIA NIM（推荐）──
# 申请: https://build.nvidia.com
NVIDIA_API_KEY=

# ── 本地 Ollama ──
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── 多模型协作路由 ──
# TOOL_MODEL: 工具调用/摘要/压缩用的模型（建议选轻量快速的）
# REPLY_MODEL: 最终回复用的模型（建议选能力强的）
# 留空则自动选择
TOOL_MODEL=minimaxai/minimax-m3
REPLY_MODEL=minimaxai/minimax-m3
ROUTE_ENABLED=true

# ── 超时配置（秒）──
# 普通对话超时
CHAT_TIMEOUT_SECONDS=300
# 任务模式超时（自主任务/多步骤任务）
TASK_TIMEOUT_SECONDS=1200
# Orchestrator 单步超时
ORCHESTRATOR_TIMEOUT_SECONDS=600

# ── 审批自动批准 ──
# 设为 1/true/yes/on 时，所有需要审批的工具调用自动通过（decidedBy='auto' 留痕，可在 /api/approval/history 审计）
# 不设置或设为 false 则维持人工审批（等待 /api/approval 批准，超时未批则中断）
APPROVAL_AUTO_APPROVE=

# ── Mesh 平台（跨机器社交）──
MESH_PLATFORM_URL=
# ⚠️ 生产环境请手动设置强密钥，首次部署后多机需保持一致
MESH_TOKEN=change-me-to-a-strong-secret

DEV_MODE=false
USE_DOCKER_SANDBOX=false
CODE_EXEC_ALLOW_VM=1

# LAN_SECRET: 局域网传输层 HMAC 签名密钥（首次启动自动生成写入 .env）
# 多机部署请手动设置为相同值；置空 LAN_SECRET= 可恢复仅协议头模式
LAN_SECRET=

# -- Hire market master switch (commercial marketplace is OFFLINE)
# When false (DEFAULT): /market.html, /market, /api/market/*, /api/mvp/*, /api/hire all return 404
# Set FEATURE_MARKET=true only when the marketplace is re-opened.
FEATURE_MARKET=false

# Credits and wallet are hidden from the UI; the tables remain for admin ops only.

# ── 云平台社交功能总开关（false=关闭好友/LAN/mesh，注册登录保留）──
FEATURE_PLATFORM=false