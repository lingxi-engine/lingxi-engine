# ────────────────────────────────────────
# 灵犀引擎 环境变量配置
# ────────────────────────────────────────
PORT=3456
DEFAULT_MODEL=minimaxai/minimax-m3

# ── NVIDIA NIM（推荐）──
# 申请: https://build.nvidia.com
NVIDIA_API_KEY=

# ── 本地 Ollama ──
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── 多模型协作路由 ──
# TOOL_MODEL: 工具调用/摘要/压缩用的模型（建议选轻量快速的）
# REPLY_MODEL: 最终回复用的模型（建议选能力强的）
# 留空则自动选择
TOOL_MODEL=minimaxai/minimax-m3
REPLY_MODEL=minimaxai/minimax-m3
ROUTE_ENABLED=true

# ── 超时配置（秒）──
# 普通对话超时
CHAT_TIMEOUT_SECONDS=300
# 任务模式超时（自主任命多步骤任务）
TASK_TIMEOUT_SECONDS=1200
# Orchestrator 单步超时
ORCHESTRATOR_TIMEOUT_SECONDS=600

# ── 审批自动批准 ──
# 设为 1/true/yes/on 时，所有需要审批的工具调用自动通过（decidedBy='auto' 留痕，可在 /api/approval/history 审计）
# 不设置或设为 false 则维持人工审批（等待 /api/approval 批准，超时未批则中断）
APPROVAL_AUTO_APPROVE=

# ────────────────────────────────────────
# 公开注册开关（v2.0.44 自部署模型）
# ────────────────────────────────────────
# 灵犀的原则：各自部署各自的服务器，各自登录各自的实例。
# 默认开放注册（未设置 / true / 1 / on）：用户在自己的实例上注册自己的账号。
# 私有实例设 REGISTRATION_OPEN=false（或 0 / off / closed / no）关闭公开注册：
# 三个注册入口（/api/auth/register、/api/auth/send-code、/api/auth/register-with-email）
# 一律返回 403 registration_closed；已有账号登录不受影响。
# REGISTRATION_OPEN=false

# ────────────────────────────────────────
# 手机 App / 多机接管（自部署模型，v2.0.44 起）
# ────────────────────────────────────────
# 手机端「我的灵犀」靠一个「设备目录」（Hub）把手机和你名下所有灵犀串起来。
# v2.0.44 起引擎【默认不连接任何官方共享云端】：留空 = 纯本地模式，
# 不向任何外部服务器登记/心跳。官网只提供下载与部署指南，不提供共享算力。
#
# 三种典型用法：
#   1) 纯本地/局域网（默认，什么都不用配；App 会自动扫描局域网发现引擎）
#   2) 自己的云端：把你自己部署的服务器当目录，电脑端指向它——
#      LINGXI_HUB_URL=https://你自己的域名
#      手机 App「我的云端」填同一个地址，登录同一账号即可在外网一键接管家里电脑。
#      云端可以是完整灵犀（默认），也可以是纯连接 Hub（HUB_ONLY=1，见下）。
#   3) 显式关闭目录：LINGXI_HUB_URL=off（等同留空）
#
# 注意：手机与电脑登录同一账号、指向同一个 Hub，才会出现在同一个「我的灵犀」列表里。
# 电脑在 NAT/防火墙后面也不用做端口映射——它会主动出站连 Hub 建反向中继，
# 手机通过 Hub 转发访问它。前提是那台电脑的灵犀在运行、且登录了同一账号。
# 隐私提示：中继流量经过 Hub 运营方——所以 Hub 必须是你自己的服务器（一条 docker 命令即可自建）。
LINGXI_HUB_URL=

# HUB_ONLY=1：把本实例变成「纯连接 Hub」（可选，开源可自建）。
# 仅保留 /api/auth/*（账号）与 /api/app/*（设备目录/中继/接管），其余 API 一律 404；
# 「我的灵犀」列表不再展示 Hub 自身。适合部署在公网服务器只做连接、不跑 AI。
# 不设或设 0 = 完整灵犀（AI + 聊天 + 好友 + 设备目录，云端本地都能跑）。
# HUB_ONLY=

# 反向中继会话键有效期（小时），默认 12
# RELAY_SESSION_TTL_HOURS=12

# ── Mesh 平台（跨机器社交）──
MESH_PLATFORM_URL=
# ⚠️ 生产环境请手动设置强密钥，首次部署后多机需保持一致
MESH_TOKEN=change-me-to-a-strong-secret

DEV_MODE=false
USE_DOCKER_SANDBOX=false
CODE_EXEC_ALLOW_VM=1

# LAN_SECRET: 局域网传输 HMAC 签名密钥（首次启动自动生成写入 .env）
# 多机部署请手动设置为相同值；置空 LAN_SECRET= 可恢复仅协议头模式
LAN_SECRET=

# -- Hire market master switch (commercial marketplace is OFFLINE) --
# When false (DEFAULT): /market.html, /market, /api/market/*, /api/mvp/*, /api/hire all return 404
# Set FEATURE_MARKET=true only when the marketplace is re-opened.
FEATURE_MARKET=false

# Credits and wallet are hidden from the UI; the tables remain for admin ops only.

# ── 云平台社交功能总开关（false=关闭好友/LAN/mesh，注册登录保留）──
FEATURE_PLATFORM=false

# === long-task v2.0 wiring (GoalExecutor checkpoint + Watchdog + force-complete routes) ===
TASK_RESUME_ROUNDS=24
COMPACT_MAX_TOKENS=80000
COMPACT_KEEP_RECENT=12
GOAL_MAX_ROUNDS=500
GOAL_TOTAL_TIMEOUT_MINUTES=0

# RAG 本地 embedding（ollama=用本地 Ollama nomic-embed-text，留空用 hash 向量）
RAG_EMBED=
RAG_EMBED_MODEL=nomic-embed-text

# LAN mDNS(Bonjour) 发现增强（1=开 0=关，默认开，缺 bonjour-service 自动降级 UDP）
LAN_MDNS=1

# A2A 协议（Agent2Agent 互操作，默认开启；=false 关闭）
A2A_ENABLED=1
# 机器对机器调用的 API Key（可选，与 JWT 二选一）
# A2A_API_KEY=
# apiKey 凭证默认绑定 agent（可选，默认取第一个 agent）

# ── Mesh WebRTC P2P 直连（信令走平台 relay，DataChannel 打通后消息直走 P2P）──
# 0=关闭（纯 relay），默认开启；node-datachannel 缺失时自动降级 relay
MESH_P2P=1
# 自定义 STUN（逗号分隔），留空用 Google 公共 STUN
# P2P_STUN=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
