{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "workspace",
    "bench",
    "src/core/index.ts",
    "src/router.ts",
    "src/index.ts",
    "src/tests",
    "_*.ts",
    "stage",
    "mobile-app",
    "app",
    "stages",
    "backup*",
    "backups",
    "rollback_*",
    "archive*",
    "_archive*",
    "_trash_20261021",
    "_trash_*",
    "archives",
    "backup_pre_*",
    "backup_sync_*",
    "*.bak*",
    "_tmp_*",
    "_data_*",
    "data-e2e*",
    "_release-*",
    "_recheck*",
    "_patch*",
    "_verify*",
    "_social*",
    "deploy/",
    "_check*",
    "_find*",
    "_fix*",
    "check-*",
    "deploy-*",
    "diff-*",
    "e2e*",
    "extract_*",
    "find_*",
    "fix_*",
    "probe-*",
    "ERR",
    "ConnectTimeout=8"
  ]
}