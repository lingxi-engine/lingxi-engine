{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "web/js/app.js"],
  "exclude": [
    "node_modules",
    "dist",
    "workspace",
    "_hermes_bak",
    "_srv_extract",
    "lingxi-engine",
    "pkg-verify",
    "mobile-dist",
    "src/mobile",
    "src/tests",
    "src/router.ts",
    "src/mesh-platform.ts",
    "src/net/lan-social.ts",
    "src/routes/auth.ts",
    "src/routes/chat.ts",
    "src/routes/friends.ts",
    "src/routes/market.ts",
    "src/routes/misc.ts"
  ]
}
