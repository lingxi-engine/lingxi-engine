{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "workspace",
    "bench",
    "src/core/index.ts",
    "src/router.ts",
    "src/index.ts",
    "src/tests",
    "_*.ts",
    "stage",
    "mobile-app",
    "app",
    "stages",
    "backup*",
    "backups",
    "rollback_*",
    "archive*",
    "_archive*",
    "_trash_20261021",
    "_trash_*",
    "archives",
    "backup_pre_*",
    "backup_sync_*",
    "*.bak*"
  ]
}
