# ----------------------------------------
# LingXi Engine environment configuration
# ----------------------------------------
PORT=3456
DEFAULT_MODEL=minimaxai/minimax-m3

# -- NVIDIA NIM (recommended, free tier) --
# Apply: https://build.nvidia.com
NVIDIA_API_KEY=

# -- Local Ollama --
OLLAMA_BASE_URL=http://localhost:11434/v1

# -- Multi-model routing --
# TOOL_MODEL: for tool calls / summarization (pick a fast model)
# REPLY_MODEL: for final replies (pick a strong model)
# Leave empty for auto selection
TOOL_MODEL=minimaxai/minimax-m3
REPLY_MODEL=minimaxai/minimax-m3

# -- Mesh platform (cross-machine social) --
# URL of your mesh platform server; empty = disabled
MESH_PLATFORM_URL=
# Must be a strong secret, identical across all machines in a mesh
MESH_TOKEN=

# -- Cloud platform (optional) --
# Connect to a LingXi cloud platform for cross-device sync and marketplace.
# Leave empty for pure local mode.
# Example: PLATFORM_URL=https://your-platform.example.com
PLATFORM_URL=

DEV_MODE=false
USE_DOCKER_SANDBOX=false
CODE_EXEC_ALLOW_VM=1

# LAN_SECRET: HMAC key for LAN transport layer (auto-generated into .env on first boot).
# Set the same value on all machines for multi-instance deployment; empty = header-only mode.
LAN_SECRET=