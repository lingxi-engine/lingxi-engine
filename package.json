{
  "name": "lingxi-engine",
  "version": "2.0.23",
  "description": "LingXi Engine - AI-native IM platform where every user gets an AI agent",
  "license": "MIT",
  "author": "LingXi Engine",
  "repository": {
    "type": "git",
    "url": "https://github.com/lingxi-engine/lingxi-engine.git"
  },
  "main": "index.ts",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node bench/run-bench.cjs",
    "verify:deploy": "node scripts/verify-deploy.cjs",
    "pack": "powershell -File scripts/pack-release.ps1",
    "release": "npm run typecheck && npm test && npm run pack"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.16.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.0.0",
    "node-fetch": "^2.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "vitest": "^1.1.0",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.10",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/node-fetch": "^2.6.11",
    "@types/better-sqlite3": "^7.6.9"
  }
}
