{
  "name": "lingxi-engine",
  "version": "2.0.45",
  "description": "LingXi Engine - AI-native IM platform where every user gets an AI agent",
  "license": "MIT",
  "author": "LingXi Engine",
  "repository": {
    "type": "git",
    "url": "https://github.com/lingxi-engine/lingxi-engine.git"
  },
  "keywords": [
    "ai-agent",
    "im",
    "chat",
    "deepseek",
    "openai",
    "typescript",
    "websocket"
  ],
  "type": "module",
  "scripts": {
    "start": "tsx index.ts",
    "dev": "tsx --watch index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:deploy": "node scripts/verify-deploy.cjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "bin": {
    "lingxi": "./src/cli/chat.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "openai": "^4.72.0",
    "qs": "^6.17.1",
    "uuid": "^14.0.2",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "bonjour-service": "^1.3.0",
    "node-datachannel": "^0.33.6",
    "puppeteer": "^25.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.12",
    "@vitest/coverage-v8": "^5.1.0",
    "docx": "^9.7.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.3.0",
    "supertest": "^7.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "qs": "^6.17.1",
    "proxy-addr": "^2.0.8",
    "source-map-js": "^1.2.2"
  }
